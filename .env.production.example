# HealthPilot HealthOS production environment.
# Copy to .env.production, load secrets from a secret manager, and rotate all
# placeholder values before any real patient data is processed.
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_TIME_ZONE=Africa/Kampala
FRONTEND_URL=https://your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
METRICS_TOKEN=change-this-metrics-token

POSTGRES_DB=healthpilot
POSTGRES_USER=healthpilot
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60
REDIS_PASSWORD=replace-with-a-strong-redis-password
CACHE_URL=redis://:replace-with-a-strong-redis-password@redis:6379/3

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
EMAIL_VERIFICATION_MINUTES=1440
PHONE_VERIFICATION_MINUTES=10
PASSWORD_RESET_MINUTES=30
MFA_CODE_MINUTES=10

# SMTP/email. Mailpit is available in the development platform stack.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=HealthPilot <no-reply@example.com>

# Payment providers. MOCK_PAYMENTS must remain false in production.
MOCK_PAYMENTS=false
PAYMENT_GATEWAY=flutterwave
PAYMENT_REDIRECT_URL=https://your-domain.example/patient/invoices
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_SUBUNIT_MULTIPLIER=1
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=https://your-domain.example/api/payments/webhooks/mtn-momo/
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_COUNTRY=UG
AIRTEL_MONEY_CURRENCY=UGX
AIRTEL_MONEY_CALLBACK_URL=https://your-domain.example/api/payments/webhooks/airtel-money/

# Notification routing and provider failover.
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=HealthPilot
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
NOTIFICATION_CALLBACK_SECRET=replace-with-a-random-shared-secret

# Private S3-compatible object storage. The bundled stack uses MinIO; change
# the endpoint for DigitalOcean Spaces, AWS S3 or another private provider.
USE_S3=true
MINIO_ROOT_USER=healthpilot-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
AWS_ACCESS_KEY_ID=healthpilot-minio
AWS_SECRET_ACCESS_KEY=replace-with-a-strong-minio-password
AWS_STORAGE_BUCKET_NAME=healthpilot-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_QUERYSTRING_EXPIRE=300
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256

# Malware scanning and upload quarantine.
CLAMAV_ENABLED=true
CLAMAV_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
ALLOW_SCAN_FAILURE=false

# Telemedicine. Use Jitsi without credentials or configure Zoom S2S OAuth.
TELEMEDICINE_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=me
ZOOM_DEFAULT_TIMEZONE=Africa/Kampala

# PACS/DICOM and imaging viewer.
ORTHANC_BASE_URL=http://orthanc:8042
ORTHANC_USERNAME=healthpilot
ORTHANC_PASSWORD=change-this-orthanc-password
PACS_ECHO_TIMEOUT_SECONDS=5
OHIF_VIEWER_BASE_URL=https://viewer.example.com

# AI/OCR verification and regulator connectors.
DOCUMENT_OCR_ENDPOINT=
DOCUMENT_OCR_TOKEN=
AI_VERIFICATION_MODEL=credential-screen-v1
AI_VERIFICATION_MODEL_VERSION=1.0.0
REGULATOR_LOOKUP_TIMEOUT_SECONDS=15

# Background workers and real-time channels.
CELERY_CONCURRENCY=4
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-redis-password@redis:6379/1
CHANNEL_REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/2
USE_INMEMORY_CHANNEL_LAYER=false
FLOWER_BASIC_AUTH=admin:replace-with-a-strong-flower-password
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOAD_DEMO_DATA=false

# Enterprise event delivery. Redpanda exposes a Kafka REST-compatible bridge.
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_REST_PROXY_URL=http://redpanda:8082
RABBITMQ_DEFAULT_USER=healthpilot
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-rabbitmq-password
RABBITMQ_URL=amqp://healthpilot:replace-with-a-strong-rabbitmq-password@rabbitmq:5672/%2F
RABBITMQ_PUBLISH_BRIDGE_URL=
EVENT_DELIVERY_MAX_ATTEMPTS=8
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_TOKEN=
OUTBOX_SIGNING_SECRET=replace-with-a-random-hmac-secret
OUTBOX_WEBHOOK_TIMEOUT=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_ALLOW_STDOUT_ACK=false

# SMART-on-FHIR partner service accounts. Rotate secrets through a secret manager.
PARTNER_CLIENT_SECRETS_JSON={}
FHIR_TOKEN_TTL_MINUTES=60

# Operations and dashboards.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
BACKUP_ENCRYPTION_KEY_REFERENCE=
BACKUP_BUCKET=healthpilot-backups
