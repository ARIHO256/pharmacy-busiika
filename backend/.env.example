DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Africa/Kampala

# SQLite development defaults. For PostgreSQL set these values:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DRF_ANON_RATE=100/hour
DRF_USER_RATE=2000/hour

MOCK_PAYMENTS=true
COMMISSION_RATE=0.10
JITSI_BASE_URL=https://meet.jit.si

# Production security controls
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
DJANGO_RUNSERVER_ADDRPORT=0.0.0.0:4000

# Operational workers and WebSocket transport (Redis is required in production)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Generate a Fernet key once; store it separately from encrypted facility data.
OFFLINE_ENCRYPTION_KEY=
PRIVATE_MEDIA_ROOT=
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=eu-west-1
CLAMAV_HOST=
CLAMAV_PORT=3310
PRIVATE_DOCUMENT_MAX_BYTES=10485760

# Server-approved integration endpoints. Do not place credentials in URLs.
DICOMWEB_URL=
DICOMWEB_TOKEN=
TERMINOLOGY_SERVER_URL=
TERMINOLOGY_SERVER_TOKEN=
HIE_SERVER_URL=
HIE_SERVER_TOKEN=
OUTBOX_WEBHOOK_URL=
OUTBOX_WEBHOOK_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
NOTIFICATION_CALLBACK_SECRET=

# Private Jitsi deployment; public unauthenticated video is development-only.
JITSI_APP_ID=
JITSI_JWT_SECRET=

# Opt-in, independently reviewed administrative drafting provider.
# Example adapter: operations.integrations.provider_draft
COPILOT_ALLOWED_ADAPTERS=
COPILOT_PROVIDER_URL=
COPILOT_PROVIDER_TOKEN=
RESEARCH_MIN_COHORT=10

# 0 disables timed in-app escalation; configure the approved response window.
LAB_CRITICAL_ESCALATION_MINUTES=0
